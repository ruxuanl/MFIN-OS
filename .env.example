# Documentation only. Do not place real credentials in this file.
APP_ENV=development
APP_BASE_URL=http://localhost:3000

# Created only after the corresponding milestone and explicit user authorization.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# M4 server-only Calendar OAuth. Keep real values in an ignored local file or host secret store.
# Prefer a separately rotatable sb_secret_... key. The legacy
# SUPABASE_SERVICE_ROLE_KEY remains supported as a compatibility fallback.
SUPABASE_SECRET_KEY=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3000/api/calendar/oauth/callback

# M6 server-only Gmail OAuth. The requested scope is exactly gmail.readonly.
# Use a dedicated test OAuth client; never add send, modify, labels, or compose.
GOOGLE_GMAIL_CLIENT_ID=
GOOGLE_GMAIL_CLIENT_SECRET=
GOOGLE_GMAIL_REDIRECT_URI=http://localhost:3000/api/gmail/oauth/callback

# M7 local monitor. Use the synthetic package script for fixtures or the
# visible/pair scripts for the approved Windows visible-UI adapter. The helper
# has no keyboard, clipboard, or WeChat send capability.

# Approved D07/D08 server-only AI adapter. Before enabling Production, verify
# current model support and prices against official OpenAI documentation and
# set the same model/rates in the provider project budget controls. The app
# separately stops reservations at HK$100 per calendar month.
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL=
OPENAI_INPUT_USD_PER_MILLION=
OPENAI_OUTPUT_USD_PER_MILLION=
OPENAI_USD_HKD_RATE=
OPENAI_REQUEST_RESERVE_HKD_CENTS=

# Unfinished resume workspace remains disabled until its schema and UI are accepted.
RESUME_WORKSPACE_ENABLED=false

# Optional private, comma-separated forwarding identifiers; leave blank by default.
GMAIL_JOB_FORWARD_IDENTIFIERS=
GMAIL_PERSONAL_FORWARD_IDENTIFIERS=
